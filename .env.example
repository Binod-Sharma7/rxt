PORT=5000
MONGO_URI=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
ALLOW_IN_MEMORY_DB=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP=false
ALLOWED_ORIGINS=http://localhost:5173
# Set to the exact number of trusted reverse-proxy hops in production; leave 0 when clients connect directly.
TRUST_PROXY_HOPS=0
VITE_API_URL=http://localhost:5000/api
VITE_ESEWA_QR_URL=https://res.cloudinary.com/jwoloh7i/image/upload/v1791999530/reforgedx/static/paymentQr.jpg

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Keep these server-only. Prefer a file path locally or your platform's secret manager in production.
FIREBASE_SERVICE_ACCOUNT_PATH=./server/firebase-service-account.json
# Alternative: one-line service-account JSON, never in VITE_* variables or frontend code.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative when GOOGLE_APPLICATION_CREDENTIALS is set by the hosting platform.
GOOGLE_APPLICATION_CREDENTIALS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
